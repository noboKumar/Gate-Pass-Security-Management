// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Visitor {
  id           String    @id @default(cuid())
  name         String
  mobile       String    @unique
  company      String?
  purpose      String
  personToMeet String
  checkIn      DateTime  @default(now())
  checkOut     DateTime?
  createdAt    DateTime  @default(now())
}

model EmployeeGatePass {
  id           String         @id @default(cuid())
  employeeName String
  department   String
  reason       String
  exitTime     DateTime?
  status       GatePassStatus @default(PENDING)
  createdAt    DateTime       @default(now())
}

enum GatePassStatus {
  PENDING
  APPROVED
  RETURNED
}
